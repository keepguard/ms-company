#!/bin/bash

# Script automatizado de deploy para MS-Auth
# Fluxo: SNAPSHOT → RELEASE → Próxima versão
# Uso: ./script-deploy-github-ms-company.sh [version] [up]
# Exemplos:
#   ./script-deploy-github-ms-company.sh 1.0.0 up    # Versão + Docker
#   ./script-deploy-github-ms-company.sh 1.0.0       # Versão + GitHub Only
#   ./script-deploy-github-ms-company.sh up          # Auto + Docker
#   ./script-deploy-github-ms-company.sh             # Auto + GitHub Only

# set -e removido para permitir que o script continue mesmo com erros no deploy

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# Funções de log colorido
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_step() { echo -e "${BLUE}[STEP]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_debug() { echo -e "${PURPLE}[DEBUG]${NC} $1"; }

# Configurações
SERVICE_NAME="ms-company"
POM_FILE="$(pwd)/pom.xml"
DOCKER_COMPOSE_FILE="../../../docker/infra/api/docker-compose.yml"
BACKUP_DIR=".deploy-backup"

# Configurações do GitHub Packages
GITHUB_REGISTRY="ghcr.io"
GITHUB_USERNAME="keepguard"
GITHUB_TOKEN=""
NAMESPACE="keepguard"

# Função para verificar e renovar token se necessário
check_github_auth() {
    log_info "Verificando autenticação no GitHub Packages..."
    
    # Tentar fazer login
    if echo "$GITHUB_TOKEN" | docker login $GITHUB_REGISTRY -u $GITHUB_USERNAME --password-stdin > /dev/null 2>&1; then
        log_success "Autenticação no GitHub Packages bem-sucedida"
        return 0
    else
        log_error "Falha na autenticação no GitHub Packages"
        log_warn "Possíveis causas:"
        log_warn "1. Token expirado ou inválido"
        log_warn "2. Problemas de conectividade"
        log_warn "3. Permissões insuficientes"
        echo ""
        log_info "Tentando continuar mesmo assim..."
        return 0
    fi
}

# Parâmetros (serão definidos pela função detect_deploy_mode)
RELEASE_VERSION=""
DEPLOY_MODE=""

# Função para detectar modo de operação
detect_deploy_mode() {
    if [ "$1" = "up" ]; then
        # Modo 3: ./script up
        RELEASE_VERSION=""
        DEPLOY_MODE="up"
        log_info "Modo detectado: Auto + Docker (versão do POM)"
    elif [ "$2" = "up" ]; then
        # Modo 1: ./script 1.0.0 up
        RELEASE_VERSION="$1"
        DEPLOY_MODE="up"
        log_info "Modo detectado: Versão $1 + Docker"
    elif [ -n "$1" ] && [ "$1" != "up" ]; then
        # Modo 2: ./script 1.0.0
        RELEASE_VERSION="$1"
        DEPLOY_MODE="github-only"
        log_info "Modo detectado: Versão $1 + GitHub Only"
    else
        # Modo 4: ./script
        RELEASE_VERSION=""
        DEPLOY_MODE="github-only"
        log_info "Modo detectado: Auto + GitHub Only (versão do POM)"
    fi
}

# Função para extrair versão atual do POM (versão do projeto, não do parent)
get_current_version() {
    # Buscar especificamente a versão do projeto ms-company
    grep -A 2 -B 2 '<artifactId>ms-company</artifactId>' "$POM_FILE" | grep '<version>' | sed 's/<version>\(.*\)<\/version>/\1/' | tr -d ' 	'
}

# Função para extrair versão base (sem -SNAPSHOT)
get_base_version() {
    local version=$(get_current_version)
    echo "${version%-SNAPSHOT}"
}

# Função para verificar se versão é SNAPSHOT
is_snapshot_version() {
    local version=$(get_current_version)
    [[ "$version" == *"-SNAPSHOT" ]]
}

# Função para verificar se versão já existe no GitHub
check_version_exists() {
    local version=$1
    local is_snapshot=$2
    
    log_info "Verificando se versão $version já existe no GitHub..."
    
    if [ "$is_snapshot" = "true" ]; then
        local url="$GITHUB_REGISTRY/$NAMESPACE/$SERVICE_NAME:$version"
    else
        local url="$GITHUB_REGISTRY/$NAMESPACE/$SERVICE_NAME:$version"
    fi
    
    # Verificar se imagem existe no GitHub Packages
    if docker manifest inspect "$url" > /dev/null 2>&1; then
        log_warn "⚠️  Versão $version já existe no GitHub!"
        return 0  # Existe
    else
        log_info "✅ Versão $version não existe no GitHub"
        return 1  # Não existe
    fi
}

# Função para incrementar versão
increment_version() {
    local version=$1
    local major=$(echo $version | cut -d. -f1)
    local minor=$(echo $version | cut -d. -f2)
    local patch=$(echo $version | cut -d. -f3)
    
    patch=$((patch + 1))
    echo "${major}.${minor}.${patch}"
}

# Função para atualizar versão no POM (versão do projeto, não do parent)
update_pom_version() {
    local new_version=$1
    log_info "Atualizando POM para versão: $new_version"
    
    # Atualizar especificamente a versão do projeto ms-company
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "/<artifactId>ms-company<\/artifactId>/,/<version>/s|<version>.*</version>|<version>$new_version</version>|" "$POM_FILE"
    else
        sed -i "/<artifactId>ms-company<\/artifactId>/,/<version>/s|<version>.*</version>|<version>$new_version</version>|" "$POM_FILE"
    fi
    
    log_success "POM atualizado para: $new_version"
}

# Função para fazer backup
create_backup() {
    # Verificar autenticação no GitHub
    check_github_auth
    log_step "Criando backup do estado atual..."
    
    rm -rf "$BACKUP_DIR"
    mkdir -p "$BACKUP_DIR"
    
    cp "$POM_FILE" "$BACKUP_DIR/"
    cp "$DOCKER_COMPOSE_FILE" "$BACKUP_DIR/" 2>/dev/null || true
    
    log_success "Backup criado em: $BACKUP_DIR"
}

# Função para restaurar backup
restore_backup() {
    log_warn "Restaurando backup..."
    
    if [ -d "$BACKUP_DIR" ]; then
        cp "$BACKUP_DIR/pom.xml" "$POM_FILE"
        cp "$BACKUP_DIR/docker-compose.yml" "$DOCKER_COMPOSE_FILE" 2>/dev/null || true
        log_success "Backup restaurado"
    fi
}

# Função para limpar backup
cleanup_backup() {
    # Salvar no repositório
    log_step "7. Salvando alterações no repositório..."
    save_to_repository "$RELEASE_VERSION"
    log_info "Limpando arquivos de backup..."
    rm -rf "$BACKUP_DIR"
    log_success "Backup removido"
}

# Função para salvar no repositório
save_to_repository() {
    local version=$1
    log_step "Salvando alterações no repositório..."
    
    # Verificar se há mudanças para commit
    if git diff --quiet && git diff --cached --quiet; then
        log_info "Nenhuma alteração detectada para commit"
        return 0
    fi
    
    # Adicionar arquivos modificados
    log_info "Adicionando arquivos modificados..."
    git add .
    
    # Fazer commit
    log_info "Fazendo commit das alterações..."
    if git commit -m "Release $version - Deploy automático

- Atualizada versão para $version
- Deploy concluído com sucesso
- Imagem Docker atualizada
- POM incrementado para próxima versão

Deploy realizado em: $(date '+%Y-%m-%d %H:%M:%S')"; then
        log_success "Commit realizado com sucesso"
        
        # Fazer push (opcional)
        log_info "Fazendo push para o repositório..."
        if git push; then
            log_success "Push realizado com sucesso"
        else
            log_warn "Falha no push, mas commit local foi realizado"
        fi
    else
        log_warn "Falha no commit, mas continuando..."
    fi
}

# Função para verificar se serviço existe no docker-compose
check_service_exists() {
    if [ ! -f "$DOCKER_COMPOSE_FILE" ]; then
        return 0
    fi
    
    # Verificar se o serviço existe no docker-compose.yml
    if grep -q "^\s*$SERVICE_NAME:" "$DOCKER_COMPOSE_FILE"; then
        return 0  # Existe
    else
        return 1  # Não existe
    fi
}

# Função para verificar pré-requisitos
check_prerequisites() {
    log_step "Verificando pré-requisitos..."
    
    # Verificar Docker
    if ! docker info > /dev/null 2>&1; then
        log_error "Docker não está rodando!"
        exit 1
    fi
    log_success "Docker está rodando"
    
    # Verificar Docker Compose
    if ! command -v docker-compose > /dev/null 2>&1; then
        log_error "Docker Compose não está instalado!"
        exit 1
    fi
    log_success "Docker Compose está disponível"
    
    
    # Verificar arquivo POM
    if [ ! -f "$POM_FILE" ]; then
        log_error "Arquivo POM não encontrado: $POM_FILE"
        exit 1
    fi
    log_success "Arquivo POM encontrado"
    
    # Verificar arquivo docker-compose (apenas se modo "up")
    if [ "$DEPLOY_MODE" = "up" ]; then
        if [ ! -f "$DOCKER_COMPOSE_FILE" ]; then
            log_error "Arquivo docker-compose.yml não encontrado: $DOCKER_COMPOSE_FILE"
            exit 1
        fi
        log_success "Arquivo docker-compose.yml encontrado"
        
        # Verificar se o serviço existe no docker-compose
        if ! check_service_exists; then
            log_warn "⚠️  Serviço $SERVICE_NAME não encontrado no docker-compose.yml"
            log_info "Adicione o serviço ao docker-compose.yml primeiro:"
            log_info "  - Adicione a configuração do serviço $SERVICE_NAME"
            log_info "  - Configure a imagem: ghcr.io/keepguard/$SERVICE_NAME:VERSION"
            log_info "  - Configure portas, dependências, etc."
            log_info ""
            log_info "Continuando apenas com deploy no GitHub..."
            log_info "Execute novamente com modo 'up' após adicionar o serviço ao docker-compose.yml"
            return 0
        fi
        log_success "Serviço $SERVICE_NAME encontrado no docker-compose.yml"
    fi
}

# Função para compilar o JAR
compile_jar() {
    local version=$1
    log_step "Compilando JAR do projeto com versão: $version"
    
    # Atualizar POM temporariamente para a versão desejada
    local current_version=$(get_current_version)
    update_pom_version "$version"
    
    # Limpar diretório target para evitar problemas de arquivos bloqueados
    log_info "Limpando diretório target..."
    rm -rf target
    
    if mvn clean package -Dmaven.test.skip=true; then
        log_success "JAR compilado com sucesso"
        # Restaurar versão original do POM
        update_pom_version "$current_version"
    else
        log_error "Erro na compilação do JAR"
        # Restaurar versão original do POM em caso de erro
        update_pom_version "$current_version"
        exit 1
    fi
}

# Função para atualizar Dockerfile com a versão correta
update_dockerfile() {
    local version=$1
    log_step "Atualizando Dockerfile com versão do JAR existente"
    
    # Backup do Dockerfile original
    cp Dockerfile Dockerfile.backup
    
    # Procurar pelo JAR específico da versão ou usar o primeiro disponível
    local existing_jar=""
    if [ -f "target/${SERVICE_NAME}-${version}.jar" ]; then
        existing_jar="target/${SERVICE_NAME}-${version}.jar"
        log_info "Encontrado JAR específico da versão: ${SERVICE_NAME}-${version}.jar"
    else
        # Fallback: usar o primeiro JAR disponível
        existing_jar=$(find target/ -name "${SERVICE_NAME}-*.jar" -not -name "*.original" | head -1)
        if [ -z "$existing_jar" ]; then
            log_error "Nenhum JAR encontrado no diretório target/"
            exit 1
        fi
        log_info "Usando JAR disponível (versão não encontrada): $(basename "$existing_jar")"
    fi
    
    local jar_name=$(basename "$existing_jar")
    log_info "Usando JAR: $jar_name"
    
    # Substituir o placeholder pelo nome real do JAR
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "s|${SERVICE_NAME}-VERSION_PLACEHOLDER.jar|$jar_name|g" Dockerfile
    else
        sed -i "s|${SERVICE_NAME}-VERSION_PLACEHOLDER.jar|$jar_name|g" Dockerfile
    fi
    
    log_success "Dockerfile atualizado para usar: $jar_name"
}

# Função para fazer build da imagem usando JAR existente
build_image_from_existing_jar() {
    local version=$1
    log_step "Fazendo build da imagem $SERVICE_NAME:$version..."
    
    # Atualizar Dockerfile com a versão correta
    update_dockerfile "$version"
    
    docker build -t "$SERVICE_NAME:$version" .
    
    if [ $? -eq 0 ]; then
        log_success "Build da imagem $SERVICE_NAME:$version concluído"
        # Restaurar Dockerfile original
        mv Dockerfile.backup Dockerfile
    else
        log_error "Erro no build da imagem $SERVICE_NAME:$version"
        # Restaurar Dockerfile original em caso de erro
        mv Dockerfile.backup Dockerfile
        exit 1
    fi
}

# Função para fazer build da imagem (mantida para compatibilidade)
build_image() {
    local version=$1
    log_step "Fazendo build da imagem $SERVICE_NAME:$version..."
    
    # Atualizar Dockerfile com a versão correta
    update_dockerfile "$version"
    
    docker build -t "$SERVICE_NAME:$version" .
    
    if [ $? -eq 0 ]; then
        log_success "Build da imagem $SERVICE_NAME:$version concluído"
        # Restaurar Dockerfile original
        mv Dockerfile.backup Dockerfile
    else
        log_error "Erro no build da imagem $SERVICE_NAME:$version"
        # Restaurar Dockerfile original em caso de erro
        mv Dockerfile.backup Dockerfile
        exit 1
    fi
}

# Função para fazer push para GitHub
push_to_github_registry() {
    local version=$1
    log_step "Fazendo push para GitHub Packages..."
    
    # Login no GitHub
    log_info "Fazendo login no GitHub Packages..."
    if ! echo "$GITHUB_TOKEN" | docker login $GITHUB_REGISTRY -u $GITHUB_USERNAME --password-stdin; then
        log_warn "Falha no login no GitHub Packages, mas continuando..."
        log_info "A imagem será construída localmente mas não enviada para o GitHub"
        return 0
    fi
    
    # Tag da imagem para o GitHub
    local github_image="$GITHUB_REGISTRY/$NAMESPACE/$SERVICE_NAME:$version"
    log_info "Fazendo tag da imagem: $SERVICE_NAME:$version -> $github_image"
    docker tag "$SERVICE_NAME:$version" "$github_image"
    
    # Push da imagem
    log_info "Fazendo push da imagem para o GitHub..."
    if docker push "$github_image"; then
        log_success "Push para GitHub concluído: $github_image"
        
        # Limpar tag local do GitHub
        docker rmi "$github_image" 2>/dev/null || true
    else
        log_warn "Falha no push para o GitHub, mas continuando com deploy local..."
        log_info "A imagem está disponível localmente: $SERVICE_NAME:$version"
    fi
}

# Função para atualizar docker-compose
update_docker_compose() {
    local version=$1
    log_step "Atualizando docker-compose.yml..."
    
    cd "$(dirname "$DOCKER_COMPOSE_FILE")"
    
    # Backup do arquivo original
    cp docker-compose.yml docker-compose.yml.backup 2>/dev/null || true
    
    # Atualizar a versão da imagem (suporta ghcr.io e localhost:9004)
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # Atualizar para usar GitHub Packages (macOS)
        sed -i '' "s|localhost:9004/keepguard/$SERVICE_NAME:[0-9.]*|ghcr.io/keepguard/$SERVICE_NAME:$version|g" docker-compose.yml
        sed -i '' "s|ghcr.io/keepguard/$SERVICE_NAME:[0-9.]*|ghcr.io/keepguard/$SERVICE_NAME:$version|g" docker-compose.yml
        # Garantir que não use versão SNAPSHOT
        sed -i '' "s|ghcr.io/keepguard/$SERVICE_NAME:[0-9.]*-SNAPSHOT|ghcr.io/keepguard/$SERVICE_NAME:$version|g" docker-compose.yml
        # Atualizar pull_policy para always (apenas para este serviço)
        sed -i '' "/$SERVICE_NAME:/,/restart:/ s|pull_policy: always|pull_policy: always|" docker-compose.yml
    else
        # Atualizar para usar GitHub Packages (Linux)
        sed -i "s|localhost:9004/keepguard/$SERVICE_NAME:[0-9.]*|ghcr.io/keepguard/$SERVICE_NAME:$version|g" docker-compose.yml
        sed -i "s|ghcr.io/keepguard/$SERVICE_NAME:[0-9.]*|ghcr.io/keepguard/$SERVICE_NAME:$version|g" docker-compose.yml
        # Atualizar pull_policy para always (apenas para este serviço)
        sed -i "/$SERVICE_NAME:/,/restart:/ s|pull_policy: always|pull_policy: always|" docker-compose.yml
    fi
    
    log_success "Docker-compose atualizado para versão: $version (GitHub Packages)"
    
    # Voltar para o diretório do serviço
    cd - > /dev/null
}

# Função para fazer deploy no Docker Compose
deploy_service() {
    local version=$1
    log_step "Fazendo deploy no Docker Compose..."
    
    cd "$(dirname "$DOCKER_COMPOSE_FILE")"
    
    # Verificar autenticação
    check_github_auth
    
    # Login no GitHub Packages para fazer pull (tentar novamente)
    log_info "Fazendo login no GitHub Packages..."
    if ! echo "$GITHUB_TOKEN" | docker login $GITHUB_REGISTRY -u $GITHUB_USERNAME --password-stdin; then
        log_warn "Falha no login, mas continuando com deploy local..."
        log_info "Usando imagem local se disponível"
    fi
    
    # Parar e remover o serviço completamente para garantir recriação
    log_info "Parando e removendo serviço $SERVICE_NAME completamente..."
    docker-compose down "$SERVICE_NAME" 2>/dev/null || true
    docker-compose rm -f "$SERVICE_NAME" 2>/dev/null || true
    
    # Tentar fazer pull da imagem
    log_info "Tentando fazer pull da imagem $SERVICE_NAME:$version..."
    if docker pull "ghcr.io/keepguard/$SERVICE_NAME:$version" 2>/dev/null; then
        log_success "Pull da imagem bem-sucedido"
    else
        log_warn "Falha no pull da imagem do GitHub, tentando usar imagem local..."
        
        # Verificar se existe imagem local
        if docker images | grep -q "$SERVICE_NAME.*$version"; then
            log_info "Usando imagem local $SERVICE_NAME:$version"
        else
            log_error "Nenhuma imagem encontrada (nem no GitHub nem local)"
            log_info "Tentando continuar com a imagem mais recente disponível..."
        fi
    fi
    
    # Iniciar o serviço com recriação completa
    log_info "Iniciando serviço $SERVICE_NAME com recriação completa..."
    
    # Se falhou no pull, usar imagem local
    if ! docker-compose up -d "$SERVICE_NAME"; then
    
    # Se falhou no pull, usar imagem local
    if ! docker-compose up -d "$SERVICE_NAME"; then
        log_warn "Falha no docker-compose up, tentando usar imagem local..."
        
        # Fazer tag da imagem local para o formato esperado pelo docker-compose
        local local_image="$SERVICE_NAME:$version"
        local compose_image="ghcr.io/keepguard/$SERVICE_NAME:$version"
        
        if docker images | grep -q "$local_image"; then
            log_info "Fazendo tag da imagem local para formato do docker-compose..."
            docker tag "$local_image" "$compose_image"
            
            # Tentar novamente
            docker-compose up -d "$SERVICE_NAME"
        else
            log_error "Nenhuma imagem local encontrada para $SERVICE_NAME:$version"
            return 1
        fi
    fi
        log_warn "Falha no docker-compose up, tentando usar imagem local..."
        
        # Fazer tag da imagem local para o formato esperado pelo docker-compose
        local local_image="$SERVICE_NAME:$version"
        local compose_image="ghcr.io/keepguard/$SERVICE_NAME:$version"
        
        if docker images | grep -q "$local_image"; then
            log_info "Fazendo tag da imagem local para formato do docker-compose..."
            docker tag "$local_image" "$compose_image"
            
            # Tentar novamente
            docker-compose up -d "$SERVICE_NAME"
    
    # Se falhou no pull, usar imagem local
    if ! docker-compose up -d "$SERVICE_NAME"; then
        log_warn "Falha no docker-compose up, tentando usar imagem local..."
        
        # Fazer tag da imagem local para o formato esperado pelo docker-compose
        local local_image="$SERVICE_NAME:$version"
        local compose_image="ghcr.io/keepguard/$SERVICE_NAME:$version"
        
        if docker images | grep -q "$local_image"; then
            log_info "Fazendo tag da imagem local para formato do docker-compose..."
            docker tag "$local_image" "$compose_image"
            
            # Tentar novamente
            docker-compose up -d "$SERVICE_NAME"
        else
            log_error "Nenhuma imagem local encontrada para $SERVICE_NAME:$version"
            return 1
        fi
    fi
        else
            log_error "Nenhuma imagem local encontrada para $SERVICE_NAME:$version"
            return 1
        fi
    fi
    
    if [ $? -eq 0 ]; then
        log_success "Deploy do serviço $SERVICE_NAME concluído"
        
        # Aguardar um pouco para o serviço inicializar
        log_info "Aguardando inicialização do serviço..."
        sleep 10
        
        # Verificar saúde do serviço
        if check_service_health; then
            log_success "Serviço $SERVICE_NAME está saudável e funcionando"
            
            # Verificação adicional: confirmar que o endpoint validate está disponível
            if [ "$SERVICE_NAME" = "ms-company" ]; then
                log_info "Verificando disponibilidade do endpoint /api/v1/auth/validate..."
                local validate_endpoint_check
                validate_endpoint_check=$(curl -s "http://localhost:8081/v3/api-docs" | jq -r '.paths | keys[]' | grep -c "validate" 2>/dev/null || echo "0")
                if [ "$validate_endpoint_check" -gt 0 ]; then
                    log_success "Endpoint /api/v1/auth/validate está disponível no Swagger"
                else
                    log_warn "Endpoint /api/v1/auth/validate não encontrado no Swagger - pode ser necessário aguardar mais tempo"
                fi
            fi
            
        else
            log_error "Serviço $SERVICE_NAME não está respondendo corretamente"
        fi
    else
        log_error "Erro no deploy do serviço $SERVICE_NAME"
    fi
    
    # Sempre remover backup do docker-compose (independente do resultado)
    rm -f docker-compose.yml.backup
    
    # Limpeza final: remover diretório de backup se existir
    rm -rf "$BACKUP_DIR"
    
    # Voltar para o diretório do serviço
    cd - > /dev/null
}

# Função para verificar saúde do serviço
check_service_health() {
    local max_attempts=30
    local attempt=1
    
    log_step "Verificando saúde do serviço $SERVICE_NAME..."
    
    cd "$(dirname "$DOCKER_COMPOSE_FILE")"
    
    while [ $attempt -le $max_attempts ]; do
        if docker-compose ps "$SERVICE_NAME" | grep -q "healthy"; then
            log_success "Serviço $SERVICE_NAME está saudável"
            cd - > /dev/null
            return 0
        elif docker-compose ps "$SERVICE_NAME" | grep -q "Up"; then
            log_info "Serviço $SERVICE_NAME está rodando, aguardando health check... (tentativa $attempt/$max_attempts)"
        else
            log_warn "Serviço $SERVICE_NAME ainda não está rodando... (tentativa $attempt/$max_attempts)"
        fi
        
        sleep 5
        ((attempt++))
    done
    
    log_error "Timeout aguardando saúde do serviço $SERVICE_NAME"
    cd - > /dev/null
    return 0
}

# Função para mostrar informações finais
show_final_info() {
    local release_version=$1
    local next_version=$2
    local mode=$3
    
    log_success "🎉 Deploy do $SERVICE_NAME:$release_version concluído com sucesso!"
    echo ""
    echo -e "${CYAN}📋 Resumo do Deploy:${NC}"
    echo "  - Versão Release: $release_version"
    echo "  - Próxima Versão: $next_version"
    echo "  - Modo: $mode"
    echo "  - GitHub Packages: $GITHUB_REGISTRY/$NAMESPACE/$SERVICE_NAME"
    echo ""
    
    if [ "$mode" = "up" ]; then
        echo -e "${CYAN}🔗 Informações de Acesso:${NC}"
        echo "  - Health Check: http://localhost:8081/actuator/health"
        echo "  - Swagger UI: http://localhost:8081/swagger-ui.html"
        echo "  - Logs: docker-compose logs -f $SERVICE_NAME"
        echo ""
        echo -e "${CYAN}📊 Logs Estruturados:${NC}"
        echo "  - Arquivo: logs/ms-company-structured.log"
        echo "  - Auditoria: logs/ms-company-audit.log"
        echo "  - Segurança: logs/ms-company-security.log"
        echo ""
    fi
    
    echo -e "${CYAN}🚀 Próximos Passos:${NC}"
    echo "  - POM atualizado para: $next_version"
    echo "  - Pronto para desenvolvimento"
    echo "  - Execute: git add . && git commit -m 'Release $release_version'"
}

# Função principal
main() {
    echo -e "${CYAN}🚀 Deploy Automatizado - MS-Auth${NC}"
    echo "=========================================="
    
    # Detectar modo de operação
    detect_deploy_mode "$@"
    
    # Determinar versão de release
    if [ -z "$RELEASE_VERSION" ]; then
        RELEASE_VERSION=$(get_base_version)
        log_info "Versão de release não especificada. Usando versão base: $RELEASE_VERSION"
    fi
    
    # Verificar se POM está em versão SNAPSHOT
    if ! is_snapshot_version; then
        log_warn "⚠️  POM não está em versão SNAPSHOT!"
        log_info "Versão atual: $(get_current_version)"
        log_info "Para deploy correto, o POM deve estar em versão SNAPSHOT"
        log_info "Exemplo: 1.0.0-SNAPSHOT"
        echo ""
        read -p "Deseja continuar mesmo assim? (y/N): " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            log_info "Deploy cancelado pelo usuário"
            exit 0
        fi
        log_warn "Continuando com versão não-SNAPSHOT..."
    fi
    
    # Verificar se a versão é válida
    if [[ ! "$RELEASE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        log_error "Versão inválida: $RELEASE_VERSION. Use o formato: X.Y.Z"
        exit 1
    fi
    
    # Verificar se versão RELEASE já existe
    if check_version_exists "$RELEASE_VERSION" "false"; then
        log_warn "⚠️  Versão RELEASE $RELEASE_VERSION já existe no GitHub!"
        echo ""
        echo "Opções disponíveis:"
        echo "1. Sobrescrever versão existente (não recomendado)"
        echo "2. Usar próxima versão disponível"
        echo "3. Cancelar deploy"
        echo ""
        read -p "Escolha uma opção (1/2/3): " -n 1 -r
        echo ""
        
        case $REPLY in
            1)
                log_warn "⚠️  Sobrescrevendo versão existente..."
                ;;
            2)
                # Encontrar próxima versão disponível
                local next_version=$RELEASE_VERSION
                while check_version_exists "$next_version" "false"; do
                    next_version=$(increment_version "$next_version")
                done
                log_info "Usando próxima versão disponível: $next_version"
                RELEASE_VERSION=$next_version
                ;;
            3)
                log_info "Deploy cancelado pelo usuário"
                exit 0
                ;;
            *)
                log_error "Opção inválida. Deploy cancelado."
                exit 1
                ;;
        esac
    fi
    
    # Calcular próxima versão
    NEXT_VERSION=$(increment_version "$RELEASE_VERSION")
    
    echo "Versão Atual: $(get_current_version)"
    echo "Versão Release: $RELEASE_VERSION"
    echo "Próxima Versão: $NEXT_VERSION"
    echo "=========================================="
    echo ""
    
    # Executar pipeline de deploy
    if ! check_prerequisites; then
        # Se check_prerequisites retornou erro (serviço não existe), continuar apenas com GitHub
        log_info "Continuando apenas com deploy no GitHub..."
        DEPLOY_MODE="github-only"
    fi
    
    # Verificar autenticação no GitHub
    check_github_auth
    
    create_backup
    # Verificar autenticação no GitHub
    check_github_auth
    
    # Compilar JAR SNAPSHOT
    log_step "1. Compilando JAR SNAPSHOT..."
    SNAPSHOT_VERSION="${RELEASE_VERSION}-SNAPSHOT"
    compile_jar "$SNAPSHOT_VERSION"
    
    # Deploy do SNAPSHOT
    log_step "2. Deploy do SNAPSHOT para GitHub..."
    build_image_from_existing_jar "$SNAPSHOT_VERSION"
    push_to_github_registry "$SNAPSHOT_VERSION"
    
    # Compilar JAR RELEASE (versão limpa, sem SNAPSHOT)
    log_step "3. Compilando JAR RELEASE..."
    compile_jar "$RELEASE_VERSION"
    
    # Deploy do RELEASE (usando JAR RELEASE)
    log_step "4. Deploy do RELEASE para GitHub..."
    build_image_from_existing_jar "$RELEASE_VERSION"
    push_to_github_registry "$RELEASE_VERSION"
    
    # Deploy no Docker Compose (apenas se modo "up" e serviço existe)
    if [ "$DEPLOY_MODE" = "up" ]; then
        log_step "5. Atualizando docker-compose e fazendo deploy..."
        update_docker_compose "$RELEASE_VERSION"
        deploy_service "$RELEASE_VERSION"
        DEPLOY_RESULT=$?
        
        # Verificar saúde do serviço
        if [ $DEPLOY_RESULT -eq 0 ] && check_service_health; then
            log_success "✅ Deploy completo concluído com sucesso!"
        else
            log_error "❌ Deploy falhou, mas continuando com atualização do POM..."
        fi
    else
        log_step "5. Deploy no GitHub concluído (modo github-only)"
    fi
    
    # Atualizar POM para próxima versão
    log_step "6. Atualizando POM para próxima versão..."
    update_pom_version "${NEXT_VERSION}-SNAPSHOT"
    
    # Salvar no repositório
    log_step "7. Salvando alterações no repositório..."
    save_to_repository "$RELEASE_VERSION"
    
    # Limpeza
    log_step "8. Limpando arquivos temporários..."
    cleanup_backup
    # Salvar no repositório
    log_step "7. Salvando alterações no repositório..."
    save_to_repository "$RELEASE_VERSION"
    
    # Mostrar informações finais
    show_final_info "$RELEASE_VERSION" "${NEXT_VERSION}-SNAPSHOT" "$DEPLOY_MODE"
}

# Tratamento de erros
trap 'log_error "Script interrompido. Restaurando backup..."; restore_backup; cleanup_backup; exit 1' INT TERM
    # Salvar no repositório
    log_step "7. Salvando alterações no repositório..."
    save_to_repository "$RELEASE_VERSION"

# Executar função principal
main "$@"
